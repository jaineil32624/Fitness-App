<resources>
    <!-- Window theme shown before Compose draws; matches the app background to avoid a flash. -->
    <style name="Theme.Repwise" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
